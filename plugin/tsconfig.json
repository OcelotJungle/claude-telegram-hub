{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test"],
  // Imports 'claude-code', whose types only the engine has; checked by
  // `claude plugin validate`.
  "exclude": ["src/mod/register.ts"]
}
