{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/hook/session-start.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/hook/stop.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/hook/question.ts\"",
            "timeout": 86400,
            "statusMessage": "Жду ответа в Телеграме"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tg-hub:tg-hub",
            "tool": "tg_hook_note",
            "input": { "agent_id": "${agent_id}" },
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "../src/mod/register.ts"
  ]
}
