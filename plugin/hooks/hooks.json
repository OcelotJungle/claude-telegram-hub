{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/hook/sessionStart.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tg-hub:tg-hub",
            "tool": "tg_hook_note",
            "input": { "agent_id": "${agent_id}" },
            "timeout": 5
          }
        ]
      }
    ]
  }
}
